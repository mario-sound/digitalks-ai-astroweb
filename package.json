{
  "name": "digitalks-web-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "node scripts/check-publication.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test scripts/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "compare": "node scripts/compare-original.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "linkedom": "^0.18.12",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1",
    "sharp": "0.34.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
