---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {general,ui,seo as allSeo,type Page} from '../lib/content';
import {readFileSync} from 'node:fs';
import siteCss from '../styles/site.css?inline';
import fontsCss from '../styles/fonts.css?inline';
interface Props {page:Page}
const {page}=Astro.props;
const seo=allSeo.find(s=>s.id===page.seo);
if(!seo)throw Error('Missing SEO '+page.id);
const canonical=new URL(seo.canonical||page.path,general.url).href;
const labels=ui[page.lang];
let inlineCss=page.css?readFileSync('src/templates/'+page.css,'utf8'):'';
for(const bg of page.backgrounds||[]){
 if(!/^\/media\/[a-zA-Z0-9._/-]+$/.test(bg.src))throw Error('Background must be a local media file');
 inlineCss=inlineCss.replaceAll(bg.original,bg.src);
}
---
<!doctype html>
<html lang={page.lang}>
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{seo.title}</title><meta name="description" content={seo.description}/>
  {general.preview&&<meta name="robots" content="noindex,nofollow"/>}
  {general.searchConsoleVerification&&<meta name="google-site-verification" content={general.searchConsoleVerification}/>}
  <link rel="canonical" href={canonical}/>
  {seo.alternates.map(alt=><link rel="alternate" hreflang={alt.lang} href={new URL(alt.path,general.url).href}/>)}
  <meta property="og:type" content="website"/><meta property="og:title" content={seo.title}/><meta property="og:description" content={seo.description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={page.lang==='es'?'es_ES':'en_US'}/>
  <meta property="og:image" content={new URL(seo.image,general.url).href}/>
  {page.styles?.map(href=><link rel="stylesheet" href={href}/>)}
  <style is:inline set:html={inlineCss}></style>
  <style is:inline set:html={fontsCss}></style>
  <style is:inline set:html={siteCss}></style>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebPage',name:seo.title,description:seo.description,url:canonical,inLanguage:page.lang}).replaceAll('<','\\u003c')}></script>
</head>
<body class={page.bodyClass||'dt-kit-46024'} data-sender-account={general.senderEnabled?general.senderAccountId:''} data-gtm-id={general.analyticsEnabled&&!general.preview?general.gtmId:''}>
  <a class="skip-link" href="#content">{labels.skip}</a>
  <Header page={page} seo={seo}/>
  <main id="content" class={page.rootClass||''} tabindex="-1">{!page.sections.some(s=>s.template)&&<h1 class="custom-page-title">{page.title}</h1>}<slot/></main>
  <Footer lang={page.lang}/>
  <dialog id="consent-dialog" aria-labelledby="consent-heading">
    <h2 id="consent-heading">{labels.consentTitle}</h2>
    <p>{labels.consentText}</p>
    <div class="consent-actions"><button data-consent="necessary">{labels.necessary}</button><button data-consent="optional">{labels.optional}</button></div>
    <a href={page.lang==='es'?'/politica-de-privacidad/':'/en/privacy-policy/'}>{labels.privacy}</a>
  </dialog>
  <script src="../scripts/client.ts"></script>
</body>
</html>
