---
import type {Section} from '../lib/content';
interface Props{section:Section}
const {section:s}=Astro.props;
---
<div class="experience-banner">
 <div class="experience-lead"><p class="experience-stat">{s.stat}</p><h2>{s.statLabel}</h2></div>
 <div class="experience-copy"><h3>{s.heading}</h3><p>{s.body}</p></div>
 <div class="expertise-marquee">
  <ul class="expertise-static">{s.logos?.length?s.logos.map(logo=><li class="experience-logo"><img src={logo.src} alt={logo.alt} width="180" height="64" loading="lazy"/></li>):s.specialties?.map(label=><li>{label}</li>)}</ul>
  <div class="marquee-window" aria-hidden="true"><div class="marquee-track">{[0,1].map(()=><div class="marquee-group">{s.logos?.length?s.logos.map(logo=><span class="experience-logo"><img src={logo.src} alt="" width="180" height="64" loading="lazy"/></span>):s.specialties?.map(label=><span>{label}<i></i></span>)}</div>)}</div></div>
 </div>
</div>
