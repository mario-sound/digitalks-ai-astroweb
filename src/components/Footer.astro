---
import {general,ui,footer} from '../lib/content';
const {lang}=Astro.props;const content=footer[lang];
---
<footer class="site-footer">
  <img src={general.logo} alt={general.title} width="205" height="44" loading="lazy"/>
  <nav aria-label={ui[lang].legal}>{content.links.map(link=><a href={link.href}>{link.label}</a>)}<span>{content.unlinked}</span></nav>
  <p>{content.copyright}</p><p>{content.credit}</p>
  <button class="consent-open" type="button">{ui[lang].consentTitle}</button>
</footer>
