    {
      "id": "en__start-5",
      "label": "Explore how we work:",
      "template": "en__start-5",
      "enabled": true,
      "texts": [
        {
          "key": "text-0",
          "label": "Explore how we work:",
          "value": "Explore how we work:"
        },
        {
          "key": "text-1",
          "label": "Hybrid",
          "value": "Hybrid "
        },
        {
          "key": "text-2",
          "label": "AI-Voice Model",
          "value": "AI-Voice Model"
        },
        {
          "key": "text-3",
          "label": "We use AI to reduce time and costs by up to 10x,",
          "value": "We use AI to reduce time and costs by up to 10x, "
        },
        {
          "key": "text-4",
          "label": "but AI is just a tool,",
          "value": "but AI is just a tool, "
        },
        {
          "key": "text-5",
          "label": "it doesn’t replace judgment.",
          "value": "it doesn’t replace judgment."
        },
        {
          "key": "text-6",
          "label": "That’s why we still record voices in-studio",
          "value": "That’s why we still record voices in-studio "
        },
        {
          "key": "text-7",
          "label": "with professional actors",
          "value": "with professional actors"
        },
        {
          "key": "text-8",
          "label": "with sound engineers",
          "value": "with sound engineers"
        },
        {
          "key": "text-9",
          "label": "with expert linguists",
          "value": "with expert linguists"
        },
        {
          "key": "text-10",
          "label": "…",
          "value": "…"
        },
        {
          "key": "text-11",
          "label": "And we combine all of that with our",
          "value": "And we combine all of that with our"
        },
        {
          "key": "text-12",
          "label": "“Character Voice Creation”",
          "value": "“Character Voice Creation”"
        },
        {
          "key": "text-13",
          "label": "We automate where it makes sense and control what matters.",
          "value": "We automate where it makes sense and control what matters."
        },
        {
          "key": "text-14",
          "label": "With more realistic performances than ever.",
          "value": "With more realistic performances than ever."
        },
        {
          "key": "text-15",
          "label": "Would you notice the difference?",
          "value": "Would you notice the difference?"
        },
        {
          "key": "text-16",
          "label": "Demos",
          "value": "Demos"
        }
