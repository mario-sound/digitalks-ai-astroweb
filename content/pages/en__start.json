        },
        {
          "key": "text-3",
          "label": "BULLS**T",
          "value": " BULLS**T"
        },
        {
          "key": "text-4",
          "label": "It would be a shame to pour blood, sweat and tears into developing your project",
          "value": "It would be a shame to pour blood, sweat and tears into developing your project"
        },
        {
          "key": "text-5",
          "label": "only to break player immersion because of a simple",
          "value": "only to break player immersion because of a simple "
        },
        {
          "key": "text-6",
          "label": "linguistic bug",
          "value": "linguistic bug"
        },
        {
          "key": "text-7",
          "label": ".",
          "value": "."
        },
        {
          "key": "text-8",
          "label": "And Grace Hopper learned it the hard way,",
          "value": "And Grace Hopper learned it the hard way, "
        },
        {
          "key": "text-9",
          "label": "a simple moth got into her computer,",
          "value": "a simple moth got into her computer, "
        },
        {
          "key": "text-10",
          "label": "and brought the system down.",
          "value": "and brought the system down."
        },
        {
          "key": "text-11",
          "label": "That’s what gave the name to what we now call bugs.",
          "value": "That’s what gave the name to what we now call bugs."
        },
        {
          "key": "text-12",
          "label": "A technical failure that causes a critical error in the user experience.",
          "value": "A technical failure that causes a critical error in the user experience."
        },
        {
          "key": "text-13",
          "label": "But AI doesn’t eliminate these bugs,",
          "value": "But AI doesn’t eliminate these bugs,"
        },
        {
          "key": "text-14",
          "label": "the expertise behind great dubbing does.",
          "value": "the expertise behind great dubbing does."
        }
