        {
          "key": "text-5",
          "label": "Real actors",
          "value": "Real actors "
        },
        {
          "key": "text-6",
          "label": "for your main characters:",
          "value": " for your main characters:"
        },
        {
          "key": "text-7",
          "label": "There are things you can cut corners on…\nthen there are your main characters. No",
          "value": "\n\t\t\t\tThere are things you can cut corners on…\nthen there are your main characters. Not there.\t\t\t"
        },
        {
          "key": "text-8",
          "label": "Why does this",
          "value": "Why does this "
        },
        {
          "key": "text-9",
          "label": "matter",
          "value": "matter"
        },
        {
          "key": "text-10",
          "label": "?",
          "value": "?"
        },
        {
          "key": "text-11",
          "label": "Because they carry your story.",
          "value": "Because they carry your story."
        },
        {
          "key": "text-12",
          "label": "They’re what make the player understand who they are.",
          "value": "They’re what make the player understand who they are."
        },
        {
          "key": "text-13",
          "label": "They’re what turn a game or serie into a memorable experience.",
          "value": "They’re what turn a game or serie into a memorable experience."
        },
        {
          "key": "text-14",
          "label": "And that’s not something you can do halfway.",
          "value": "And that’s not something you can do halfway."
        },
        {
          "key": "text-15",
          "label": "That’s why we don’t use AI here.",
          "value": "That’s why we don’t use AI here."
        },
        {
          "key": "text-16",
          "label": "We use real actors.",
          "value": "We use real actors."
        },
        {
          "key": "text-17",
          "label": "To bring all those nuances and emotion",
          "value": "To bring all those nuances and emotion"
        },
        {
          "key": "text-18",
          "label": "where technology still falls short.",
          "value": "where technology still falls short."
        },
        {
          "key": "text-19",
          "label": "How do we",
          "value": "How do we "
        },
        {
          "key": "text-20",
          "label": "make it happen",
          "value": "make it happen"
        },
        {
          "key": "text-21",
          "label": "?",
          "value": "?"
        },
        {
          "key": "text-22",
          "label": "We select the voices that truly fit each character.",
          "value": "We select the voices that truly fit each character."
        },
        {
          "key": "text-23",
          "label": "We direct every session to make sure the emotion lands exactly where it should.",
          "value": "We direct every session to make sure the emotion lands exactly where it should."
        },
        {
          "key": "text-24",
          "label": "We record in-studio, using our usual method:",
          "value": "We record in-studio, using our usual method:"
        },
        {
          "key": "text-25",
          "label": "Acoustically treated recording rooms",
          "value": "Acoustically treated recording rooms"
        },
        {
          "key": "text-26",
          "label": "High-end microphones and equipment",
          "value": "High-end microphones and equipment"
        },
        {
          "key": "text-27",
          "label": "And plenty of machine coffee",
          "value": "And plenty of machine coffee"
        },
        {
          "key": "text-28",
          "label": "No shortcuts.",
          "value": "No shortcuts."
        },
        {
          "key": "text-29",
          "label": "and then we",
          "value": "and then we "
        },
        {
          "key": "text-30",
          "label": "bring it all together",
          "value": "bring it all together"
        },
        {
          "key": "text-31",
          "label": "...",
          "value": "..."
        },
        {
          "key": "text-32",
          "label": "All of this is integrated into the",
          "value": "All of this is integrated into the"
        },
        {
          "key": "text-33",
          "label": "Hybrid AI-Voice Model",
          "value": "Hybrid AI-Voice Model"
        },
        {
          "key": "text-34",
          "label": "that scales the rest of the game.",
          "value": "that scales the rest of the game."
        },
        {
          "key": "text-35",
          "label": "NPCs, secondary dialogue, volume",
          "value": "NPCs, secondary dialogue, volume"
        },
        {
          "key": "text-36",
          "label": "…",
          "value": "…"
        },
        {
          "key": "text-37",
          "label": "That’s where we use AI.",
