    {
      "id": "en__start-6",
      "label": "We don’t just translate…",
      "template": "en__start-6",
      "enabled": true,
      "texts": [
        {
          "key": "text-0",
          "label": "We don’t just translate…",
          "value": "We don’t just translate…\n"
        },
        {
          "key": "text-1",
          "label": "WE LOCALIZE",
          "value": "WE LOCALIZE"
        },
        {
          "key": "text-2",
          "label": "Localization is not just about translating or recording voices in other language",
          "value": "Localization is not just about translating or recording voices in other languages."
        },
        {
          "key": "text-3",
          "label": "It’s about making the original content feel the same, anywhere in the world.",
          "value": "It’s about making the original content feel the same, anywhere in the world."
        },
        {
          "key": "text-4",
          "label": "Or put another way",
          "value": "Or put another way"
        },
        {
          "key": "text-5",
          "label": "…",
          "value": "…"
        },
        {
          "key": "text-6",
          "label": "So the player doesn’t just understand the meaning of the original script,",
          "value": "So the player doesn’t just understand the meaning of the original script, "
        },
        {
          "key": "text-7",
          "label": "but also experiences jokes,",
          "value": "but also experiences jokes,"
        },
        {
          "key": "text-8",
          "label": "wordplay,",
          "value": "wordplay,"
        },
        {
