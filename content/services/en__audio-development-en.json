    {
      "id": "en__audio-development-en-10",
      "label": "Questions? Doubts? Skepticism?",
      "template": "en__audio-development-en-10",
      "enabled": true,
      "texts": [
        {
          "key": "text-0",
          "label": "Questions? Doubts? Skepticism?",
          "value": "Questions? Doubts? Skepticism?"
        },
        {
          "key": "text-1",
          "label": "We answer them here.",
          "value": "We answer them here."
        },
        {
          "key": "text-2",
          "label": "If after reading all this you still have questions, they’re probably really",
          "value": "\nIf after reading all this you still have questions, they’re probably really "
        },
        {
          "key": "text-3",
          "label": "good ones",
          "value": "good ones"
        },
        {
          "key": "text-4",
          "label": ".",
          "value": "."
        },
        {
          "key": "text-5",
          "label": "Contact us and we’ll answer them.",
          "value": "\nContact us and we’ll answer them."
        },
        {
          "key": "text-6",
          "label": "What exactly do you do?",
          "value": "What exactly do you do?"
        },
        {
          "key": "text-7",
          "label": "“We build custom software and workflows to automate the stuff you hate doing in ",
          "value": " “We build custom software and workflows to automate the stuff you hate doing in your company. The things that steal your time and patience.”"
        },
        {
          "key": "text-8",
          "label": "Are you expensive?",
          "value": "Are you expensive?"
        },
        {
          "key": "text-9",
          "label": "“We’re not cheap. But paying endless hours for replaceable tasks isn’t cheap eit",
          "value": "“We’re not cheap. But paying endless hours for replaceable tasks isn’t cheap either (remember the elevator and the stairs). What we offer is an investment, not an expense.”"
        },
        {
          "key": "text-10",
          "label": "Do you only work with audio?",
          "value": "Do you only work with audio?"
        },
        {
          "key": "text-11",
          "label": "“We specialize in audio, but we can build any tool that makes your life easier.”",
          "value": "“We specialize in audio, but we can build any tool that makes your life easier.”"
        },
        {
          "key": "text-12",
          "label": "Can I request a demo?",
          "value": "Can I request a demo?"
        },
        {
          "key": "text-13",
          "label": "“Yes. We have a portfolio with real-world cases: from listening tools to the mas",
          "value": "“Yes. We have a portfolio with real-world cases: from listening tools to the mass renaming and conversion of 50,000 files.”"
        },
        {
          "key": "text-14",
          "label": "How do payments work?",
          "value": "How do payments work?"
        },
        {
          "key": "text-15",
          "label": "“By sprints or partial deliveries. You see progress every 2 weeks (or whatever t",
          "value": "“By sprints or partial deliveries. You see progress every 2 weeks (or whatever timeframe we agree on) and you pay based on what you receive. Transparent and fully under control.”"
        },
        {
          "key": "text-16",
          "label": "Do you replace employees?",
          "value": "Do you replace employees?"
        },
        {
          "key": "text-17",
          "label": "“What we replace are pointless tasks. If you’re paying someone just to rename fi",
          "value": "“What we replace are pointless tasks. If you’re paying someone just to rename files, it’s time to change the system. Would you stop cleaning your house if you bought a Roomba? No, right? Exactly.”"
        },
        {
          "key": "text-18",
          "label": "Who are you?",
          "value": "Who are you?"
        },
        {
          "key": "text-19",
          "label": "“Over 10 years in audio for video games, dubbing, and more. We’ve dealt with tho",
          "value": "“Over 10 years in audio for video games, dubbing, and more. We’ve dealt with thousands of files, impossible scripts, and chaotic workflows. That’s where the tools we now put at your service were born.”"
        }
      ],
