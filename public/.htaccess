# Apache/LiteSpeed static-site configuration. Never copies WordPress rewrite rules.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://*.sender.net; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://cdn.sender.net https://www.googletagmanager.com; connect-src 'self' https://*.sender.net https://*.google-analytics.com https://www.googletagmanager.com; frame-src https://www.youtube-nocookie.com https://*.sender.net; media-src 'self'; form-action 'self' https://*.sender.net; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^voz-ia/?$ / [R=301,L,NE]
  RewriteRule ^en/ia-voice/?$ /en/start/ [R=301,L,NE]
  RewriteRule ^locucionesia/?$ /#voces [R=301,L,NE]
  RewriteRule ^en/voiceoverai/?$ /en/start/#voces [R=301,L,NE]
  RewriteRule ^custom-audio-data-collection/?$ /audio-data-collection/ [R=301,L,NE]
  RewriteRule ^doblaje-youtube/?$ /#produccion [R=301,L,NE]
  # Retired catalogue: no equivalent product.
  RewriteRule ^ots-audio-data-collection/?$ - [G,L]
  # hPanel SSL must be working before deploying. Local Astro preview ignores .htaccess.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType audio/mpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 410 /ots-audio-data-collection/index.html
